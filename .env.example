# Copy the variables you need into the cloud environment settings (or a local, gitignored .env).
# Never commit real values.

# Jev research (D11) — TypeSafe System One
JEV_API_KEY=

# Email (build step 8). Live alerts are DISABLED in code; only `npm run email:demo`
# (a synthetic test signal) sends anything.
EMAIL_PROVIDER=console          # console | file | smtp | resend
EMAIL_FROM=
EMAIL_TO=                       # comma-separated
EMAIL_OUTBOX_DIR=data/outbox    # file provider only
SMTP_HOST=                      # e.g. smtp.gmail.com (Gmail needs an app password)
SMTP_PORT=587
SMTP_SECURE=false               # true for port 465
SMTP_USER=
SMTP_PASS=
RESEND_API_KEY=
